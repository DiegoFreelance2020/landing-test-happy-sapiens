# Public Supabase config (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase service role key (used by the /api/submit route to bypass RLS)
# NEVER expose this to the client. Set it as a Netlify env var, not in NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used to build absolute share links / OG metadata)
NEXT_PUBLIC_SITE_URL=https://test.happysapiens.co

# Server-only. Clave estable para cifrar los IDs de acciones de Next.js.
# Mantiene los build IDs consistentes entre redeploys / instancias (PM2) y
# evita el error "Failed to find Server Action" por clientes desincronizados.
# Generar una vez con: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=your-32-byte-base64-key
